# ------------------------------------------------------------
# Postgres 直結（書き込み経路と LISTEN/NOTIFY 用）
# ------------------------------------------------------------
# ⚠️ 必ずセッションモードの接続文字列を使うこと。
#
#   OK  直結            db.<ref>.supabase.co:5432
#   OK  プーラ(session)  aws-0-<region>.pooler.supabase.com:5432
#   NG  プーラ(transaction) ...:6543
#
# transaction モード(6543)では LISTEN が機能せず、SELECT ... FOR UPDATE を
# 文をまたいで保持することもできない。しかも LISTEN は成功したように見えて
# 通知だけが永久に届かないという壊れ方をするので、必ず 5432 を使うこと。
#
# ローカル開発(supabase start)の既定値:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------
# Supabase（参照専用エンドポイントの読み取りに使う）
# ------------------------------------------------------------
# ↓ レガシー形式だったから使わないよ
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ------------------------------------------------------------
# サーバー
# ------------------------------------------------------------
PORT=8787

# 営業日の判定に使うタイムゾーン。DB 側の関数も既定で Asia/Tokyo を使う。
BUSINESS_TIME_ZONE=Asia/Tokyo

# カンマ区切り。管理画面のオリジンを指定する。
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# バックグラウンドジョブ / SSE
# ------------------------------------------------------------
# 呼び出しから何分で自動完了させるか（仕様は15分）
AUTO_COMPLETE_MINUTES=15

# ジョブの実行間隔。仕様が許容する遅延は5〜10秒程度。
JOB_TICK_MS=5000

# SSE のハートビート間隔。お客様仕様は15〜30秒。
SSE_HEARTBEAT_MS=20000
